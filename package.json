{
  "name": "math-memory-brain-app",
  "version": "1.0.0",
  "description": "Ứng dụng rèn luyện tính nhẩm nhanh và kiểm tra trí nhớ cuối tuần với AI nhận diện chữ viết tay",
  "main": "main_desktop.py",
  "scripts": {
    "start:desktop": "python main_desktop.py",
    "build:exe": "pyinstaller --noconsole --onefile main_desktop.py",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  }
}
